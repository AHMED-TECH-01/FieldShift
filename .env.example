# ==============================================================================
# FieldShift — Environment Variables Template (Placeholders Only)
# ==============================================================================
# Copy this file to .env for local development. Never commit .env files to Git.

# --- Frontend Public Variables (Exposed to Vite browser bundle) ---
VITE_API_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=

# --- Backend Secrets & API Keys (Server / Vercel Serverless Only) ---
SUPABASE_URL=
SUPABASE_SECRET_KEY=
GEMINI_API_KEY=
GEMINI_TIMEOUT_MS=25000

# --- Optional NASA Earthdata Credentials ---
# NASA POWER & NASA Earthdata CMR granule discovery work without tokens.
# Only set EARTHDATA_TOKEN if adding HDF5/NetCDF4 binary granule downloads.
EARTHDATA_TOKEN=
NASA_API_KEY=

# --- Optional Local Development Settings (Not required on Vercel) ---
APP_PORT=3000
APP_URL=http://localhost:3000
DISABLE_HMR=true