# ==============================================================================
# FIELD SHIFT — ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# 1. Google Gemini AI API Key (Required for AI Agricultural Advisor)
# In AI Studio: Automatically injected from the Settings > Secrets panel.
# In local/Cloud Run: Provide your Google AI Studio Gemini API key.
GEMINI_API_KEY="AIzaSy..."

# 2. Application Hosting URL
# In AI Studio: Automatically set to the Cloud Run service URL.
# In local development: http://localhost:3000
# Used for SSL detection, WebSocket HMR reverse-proxy routing, and canonical links.
APP_URL="http://localhost:3000"

# 3. Server Port
# Defaults to 3000 for local development. Google Cloud Run automatically sets 8080.
PORT=3000

# 4. Node Environment
# Use 'development' for Vite dev middleware and HMR, or 'production' to serve built /dist files.
NODE_ENV="development"

# 5. Gemini Request Timeout (Milliseconds)
# Maximum wait duration for Gemini 3.8 Flash / 3.1 Flash Lite responses before activating fallback.
# Default is 25000 (25 seconds).
GEMINI_TIMEOUT_MS=25000

# 6. HMR Control (Optional)
# Set to 'true' to disable Hot Module Replacement and file watchers.
DISABLE_HMR="false"

# 7. NASA Earthdata & APIs (Optional)
# Public endpoints work without keys. Use to expand rate limits or query DAAC granules.
# NASA_API_KEY="DEMO_KEY"
# EARTHDATA_TOKEN="eyJhbGciOiJIUzI1Ni..."

