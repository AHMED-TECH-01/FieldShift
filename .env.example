# ==============================================================================
# FIELD SHIFT — ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER-ONLY ENVIRONMENT VARIABLES (NEVER exposed to frontend bundle)
# ------------------------------------------------------------------------------

# Google Gemini AI API Key (Required for AI Agricultural Advisor server-side endpoint)
# Used exclusively inside server-side code (app.ts / api/index.ts). Never exposed to browser.
# In Vercel: Set in Project Settings > Environment Variables (Environment: Production & Preview).
# In AI Studio: Automatically provided from the runtime secrets.
GEMINI_API_KEY="AIzaSy..."

# Server Port (Local monolithic development only)
# Defaults to 3000. In Vercel serverless execution, port listening is bypassed.
PORT=3000

# Node Environment
# 'development' for local tsx/vite dev mode, 'production' for production builds.
NODE_ENV="development"

# Gemini Request Timeout (Milliseconds)
# Maximum wait duration for Gemini 3.8 Flash / 3.1 Flash Lite responses before activating fallback.
# Default is 25000 (25 seconds).
GEMINI_TIMEOUT_MS=25000

# Application Hosting URL (Server-only / Climatology canonical reference)
APP_URL="http://localhost:3000"

# Optional NASA Earthdata / Direct DAAC API Keys (Server-only)
# Public endpoints work without keys. Use to expand rate limits if querying DAAC granules directly.
# NASA_API_KEY="DEMO_KEY"
# EARTHDATA_TOKEN="eyJhbGciOiJIUzI1Ni..."

# Optional Supabase Service Role Key (SERVER-ONLY — NEVER prefix with VITE_)
# If persisting farm parcels or user profiles to Supabase backend:
# SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."


# ------------------------------------------------------------------------------
# 2. CLIENT-SAFE / FRONTEND ENVIRONMENT VARIABLES (VITE_ prefixed only)
# ------------------------------------------------------------------------------

# Frontend API Base URL (Optional)
# In Vercel and monolithic local dev: Leave empty or omit completely so requests use relative '/api' paths.
# If frontend is hosted on a completely separate domain from the API:
# VITE_API_URL="https://your-api-domain.vercel.app"

# Supabase Public Client Credentials (Optional client-safe anonymous keys)
# Safe for frontend if Row Level Security (RLS) is enabled in your Supabase project.
# VITE_SUPABASE_URL="https://your-project.supabase.co"
# VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# HMR Control (Development only)
DISABLE_HMR="false"
